<html>
<head>
<title>Enregistrement en direct - CBILLING</title>
<hta:application
    id="iptvRecorder"
    applicationname="Enregistreur IPTV VLC"
    border="dialog"
    borderstyle="normal"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    version="2.1"
    windowstate="normal"
/>
<style>
    body { font-family: Segoe UI, Arial; font-size: 20px; background: #f4f4f4; margin: 10px; overflow: hidden }
    fieldset { margin-bottom: 10px; background: #ffffff; border: 1px solid #cccccc; }
    legend { font-weight: bold; }
    select, input[type=text] { width: 100%; padding: 6px; font-size: 20px; box-sizing: border-box; }
    .marge_txt { margin-bottom: 8px; }
	

.timers {
    width: 100%;
    text-align: center;
}

#elapsedTimer {
    font-size: 38px;
    font-weight: bold;
    text-align: center;
    color: #008000;
    background: #ffffff;
    padding: 0px;
}

#bigTimer {
    font-size: 38px;
    font-weight: bold;
    text-align: center;
    color: #CB4127;
    background: #ffffff;
    padding: 0px;
}
	
#info {
    font-family: Consolas, monospace;
    background: #eeeeee;
    padding: 10px;
    height: 110px;
    overflow-y: auto;
    white-space: pre-wrap;
}
	
	
.button {
    display: inline-block;
	vertical-align: middle;
    width: 160px;
    height: 42px;
    padding: 2px 10px;
    box-sizing: border-box;
    font-family: Segoe UI, Arial;
    font-size: 22px;
    font-weight: bold;
    margin: 4px;
    border: 1px solid #555555;
    border-radius: 6px;
    cursor: pointer;
}
button {
    border-radius: 6px;
    -webkit-appearance: none;
}

.saisie {
    display: inline-block;
	vertical-align: middle;
    width: 160px;
    height: 42px;
    padding: 2px 10px;
    box-sizing: border-box;
    font-family: Segoe UI, Arial;
    font-size: 22px;
    font-weight: bold;
    margin: 4px;
    border: 1px solid #555555;
    border-radius: 6px;
}



#watchBtn { background: #0379BD; color: white; }
#startBtn { background: #2e7d32; color: white; }
#stopBtn { background: #c62828; color: white; }

#okIdent { background: #F0F0F0; color: #000;  }

#watchBtn.inactif,
#startBtn.inactif,
#stopBtn.inactif {
    background-color: #C0C0C0 !important;
    color: #000000 !important;
    border: 1px solid #999999 !important;
    cursor: default !important;
}

.inactif {
    cursor: default !important;
}

.texte_lib {
    font-size: 22px;
}

</style>

<script language="VBScript">
Const VLC_PATH = "C:\Program Files\VideoLAN\VLC\vlc.exe"
Const URL_BASE = "http://s04.wsbof.com:8080/s/"
Const DEFAULT_IDENTIFIER = "" 
Const RC_PORT = "4212"
Const RECORD_DIR = "C:\Enregistrements"

Dim channels, recording, startDate, durationSeconds, timerId
Dim scheduleEnabled, scheduleTime, scheduleTimerId
Dim configFile
Dim modeActif
Dim scheduleDate
Dim calendarMonth, calendarYear

'	https://cbilling.eu/index.php?mode=idx

channels = Array( _
    "pervyj.m3u8", "rossija.m3u8", "ntv.m3u8", "ntv-mir.m3u8", _
    "TNT.m3u8", "tnt4.m3u8", "CTC.m3u8", "bridge-tv-shlager.m3u8", _
    "ru-tv.m3u8", "muz-tv.m3u8", "inter-ua.m3u8", "1-plus-1.m3u8", _
    "2-plus-2-ua.m3u8", "ictv-ua.m3u8", "kus-kus-ua.m3u8", _
    "novyj-kanal-ua.m3u8", "stb-ua.m3u8", "ntn-ua.m3u8", "24ch-ua.m3u8" _



Sub Window_OnLoad

    window.resizeTo 720, 650

    Dim i, suffix, label, optionItem, fso

    recording = False
    timerId = ""
    scheduleEnabled = False
    scheduleTimerId = ""
    scheduleTime = ""
    modeActif = ""

    document.getElementById("elapsedTimer").innerText = "00:00:00"

    document.getElementById("identifier").value = DEFAULT_IDENTIFIER
    document.getElementById("duration").value = "60"
    document.getElementById("duration_prog").value = "90"
    document.getElementById("scheduleTime").value = "12:00"

    scheduleDate = Date

    Set fso = CreateObject("Scripting.FileSystemObject")
    configFile = fso.GetParentFolderName(location.pathname) & "\magneto.json"

    document.getElementById("channelList").innerHTML = ""

    For i = 0 To UBound(channels)
        suffix = channels(i)
        label = Replace(suffix, ".m3u8", "")
        Set optionItem = document.createElement("option")
        optionItem.value = suffix
        optionItem.text = label
        document.getElementById("channelList").add optionItem
    Next

    LoadConfig
	ActualiserHeure

    ActualiserDate

    If scheduleEnabled Then

        document.getElementById("scheduleBtn").innerText = "ON"
        document.getElementById("scheduleBtn").style.backgroundColor = "#000000"
        document.getElementById("scheduleBtn").style.color = "#FFF"

        scheduleTimerId = window.setInterval("CheckSchedule", 10000)

    Else

        document.getElementById("scheduleBtn").innerText = "OFF"
        document.getElementById("scheduleBtn").style.backgroundColor = "#DDDDDD"
        document.getElementById("scheduleBtn").style.color = "#989898"

    End If

    UpdateButtons
    UpdateInfo "Pret." & vbCrLf & "Interface RC (127.0.0.1:" & RC_PORT & ")"

End Sub



Function JsonValue(content, key)

    Dim re, matches

    Set re = CreateObject("VBScript.RegExp")

    re.Global = False
    re.IgnoreCase = True
    re.Pattern = """" & key & """\s*:\s*(""[^""]*""|true|false|[0-9]+)"

    Set matches = re.Execute(content)

    If matches.Count > 0 Then
        JsonValue = matches(0).SubMatches(0)
        JsonValue = Replace(JsonValue, """", "")
    Else
        JsonValue = ""
    End If

End Function



Sub LoadConfig

    Dim fso, ts, content, v, h, m

    On Error Resume Next

    Set fso = CreateObject("Scripting.FileSystemObject")

    If fso.FileExists(configFile) Then

        Set ts = fso.OpenTextFile(configFile, 1)
        content = ts.ReadAll
        ts.Close

        ' Identifiant utilisateur
        v = JsonValue(content, "identifier")
        If v <> "" Then
            document.getElementById("identifier").value = v
        End If

        ' Date programmee
        v = JsonValue(content, "scheduleDate")

        If Len(v) = 10 Then
            If Mid(v, 5, 1) = "-" And Mid(v, 8, 1) = "-" Then
                scheduleDate = DateSerial( _
                    CInt(Left(v, 4)), _
                    CInt(Mid(v, 6, 2)), _
                    CInt(Right(v, 2)))
            End If
        End If

        ' Heure et minutes programmees
        h = JsonValue(content, "scheduleHour")
        m = JsonValue(content, "scheduleMinute")

        If IsNumeric(h) And IsNumeric(m) Then

            If CInt(h) >= 0 And CInt(h) <= 23 And _
               CInt(m) >= 0 And CInt(m) <= 59 Then

                document.getElementById("scheduleTime").value = _
                    Right("0" & CInt(h), 2) & ":" & _
                    Right("0" & CInt(m), 2)

            End If

        End If

        ' Duree programmee
        v = JsonValue(content, "duration_prog")

        If IsNumeric(v) Then
            If CDbl(v) > 0 Then
                document.getElementById("duration_prog").value = v
            End If
        End If

        ' Activation de la programmation
        v = JsonValue(content, "scheduleEnabled")

        If LCase(v) = "true" Then
            scheduleEnabled = True
        Else
            scheduleEnabled = False
        End If

    End If

    On Error GoTo 0

    ActualiserDate

End Sub




Sub SaveConfig

    Dim fso, ts, id, d, h, m, duree, actif

    id = Trim(document.getElementById("identifier").value)

    d = Year(scheduleDate) & "-" & _
        Right("0" & Month(scheduleDate), 2) & "-" & _
        Right("0" & Day(scheduleDate), 2)

    h = Left(document.getElementById("scheduleTime").value, 2)
    m = Right(document.getElementById("scheduleTime").value, 2)

    duree = document.getElementById("duration_prog").value

    If scheduleEnabled Then
        actif = "true"
    Else
        actif = "false"
    End If

    On Error Resume Next

    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.CreateTextFile(configFile, True)

    ts.Write "{""identifier"":""" & id & """," & _
             """scheduleEnabled"":" & actif & "," & _
             """scheduleDate"":""" & d & """," & _
             """scheduleHour"":" & h & "," & _
             """scheduleMinute"":" & m & "," & _
             """duration_prog"":" & duree & "}"

    ts.Close

    On Error GoTo 0

End Sub



Sub UpdateButtons

    Dim watchBtn, startBtn, stopBtn

    Set watchBtn = document.getElementById("watchBtn")
    Set startBtn = document.getElementById("startBtn")
    Set stopBtn = document.getElementById("stopBtn")
	
	watchBtn.disabled = (modeActif <> "")
	startBtn.disabled = (modeActif <> "")
	stopBtn.disabled = (modeActif = "")
	
	document.getElementById("razBtn").disabled = (modeActif <> "")

    ' Réinitialisation des styles directs
    watchBtn.style.backgroundColor = ""
    watchBtn.style.color = ""

    startBtn.style.backgroundColor = ""
    startBtn.style.color = ""

    stopBtn.style.backgroundColor = ""
    stopBtn.style.color = ""

    ' Etat initial
    watchBtn.className = "button"
    startBtn.className = "button"
    stopBtn.className = "button inactif"

    ' Visionnage ou enregistrement
    If modeActif <> "" Then
        watchBtn.className = "button inactif"
        startBtn.className = "button inactif"
        stopBtn.className = "button"
    End If

End Sub


Sub ActualiserHeure

    Dim h, m

    h = Left(document.getElementById("scheduleTime").value, 2)
    m = Right(document.getElementById("scheduleTime").value, 2)

    document.getElementById("heureAffiche").innerHTML = _
        "<button class='button' style='width:138px;' onclick='ModifierHeure'>" & h & "</button>"

    document.getElementById("minuteAffiche").innerHTML = _
        "<button class='button' style='width:138px;' onclick='ModifierMinute'>" & m & "</button>"

End Sub



Sub StartViewing

    Dim shell, identifier, channel, url

    If modeActif <> "" Then Exit Sub

    identifier = Trim(document.getElementById("identifier").value)

    If identifier = "" Then
        MsgBox "Identifiant manquant.", 48, "Erreur"
        Exit Sub
    End If

    channel = document.getElementById("channelList").value

    If channel = "" Then Exit Sub

    url = URL_BASE & identifier & "/" & channel

    Set shell = CreateObject("WScript.Shell")

CloseVLC

UpdateInfo "Lancement de VLC en mode visionnage..."

    shell.Run """" & VLC_PATH & """ """ & url & """ --extraintf=rc --rc-host=127.0.0.1:" & RC_PORT & " --rc-quiet", 1, False

    modeActif = "watching"

    UpdateButtons
    AppendInfo "Visionnage demarre."

End Sub


Sub UpdateInfo(text)
    document.getElementById("info").innerText = text
End Sub

Sub AppendInfo(text)
    Dim info
    Set info = document.getElementById("info")
    info.innerText = info.innerText & vbCrLf & text
    info.scrollTop = info.scrollHeight
End Sub

Function IsVLCRunning()
    Dim shell, result
    Set shell = CreateObject("WScript.Shell")
    result = shell.Run("cmd /c tasklist /FI ""IMAGENAME eq vlc.exe"" 2>nul | find /I ""vlc.exe"" >nul", 0, True)
    IsVLCRunning = (result = 0)
End Function

Sub CloseVLC
    Dim shell
    Set shell = CreateObject("WScript.Shell")
    shell.Run "cmd /c taskkill /F /IM vlc.exe >nul 2>&1", 0, True
End Sub

' Envoie une commande à l'interface RC de VLC
Sub SendRC(cmd)
    Dim shell, ps
    Set shell = CreateObject("WScript.Shell")
    ps = "powershell -NoProfile -Command ""$c = New-Object System.Net.Sockets.TcpClient('127.0.0.1'," & RC_PORT & "); $s = $c.GetStream(); $w = New-Object System.IO.StreamWriter($s); $w.WriteLine('" & cmd & "'); $w.Flush(); $c.Close()"""
    shell.Run ps, 0, True
End Sub

Sub StartRecording
    Dim shell, identifier, channel, minutes, url

    If modeActif <> "" Then Exit Sub

    identifier = Trim(document.getElementById("identifier").value)
    If identifier = "" Then
        MsgBox "Identifiant manquant.", 48, "Erreur"
        Exit Sub
    End If

    If Not IsNumeric(document.getElementById("duration").value) Then
        MsgBox "Duree invalide.", 48, "Erreur"
        Exit Sub
    End If
    minutes = CDbl(document.getElementById("duration").value)
    If minutes <= 0 Then
        MsgBox "La duree doit etre > 0.", 48, "Erreur"
        Exit Sub
    End If

    channel = document.getElementById("channelList").value
    If channel = "" Then
        MsgBox "Choisissez une chaine.", 48, "Erreur"
        Exit Sub
    End If

    durationSeconds = CLng(minutes * 60)
    url = URL_BASE & identifier & "/" & channel

    Set shell = CreateObject("WScript.Shell")

CloseVLC

UpdateInfo "Lancement de VLC avec interface RC..."
	
    shell.Run """" & VLC_PATH & """ """ & url & """ --extraintf=rc --rc-host=127.0.0.1:" & RC_PORT & " --rc-quiet", 1, False

    ' Envoie la commande pour démarrer l'enregistrement
    SendRC "key key-record"

    recording = True
	modeActif = "recording"
    startDate = Now
    UpdateButtons
    AppendInfo "START envoye via RC."
    AppendInfo "Duree programmee : " & minutes & " min"
    timerId = window.setInterval("TimerTick", 1000)
End Sub

Sub StopRecording
    If Not recording Then Exit Sub

    AppendInfo "STOP envoye via RC..."
    SendRC "key key-record"

    CloseVLC

    recording = False
	modeActif = ""
    If timerId <> "" Then
        window.clearInterval timerId
        timerId = ""
    End If
    UpdateButtons
    AppendInfo "Enregistrement arrete."
End Sub

Sub StopAction
    If modeActif = "recording" Then
        StopRecording
    ElseIf modeActif = "watching" Then
        StopViewing
    End If
End Sub

Sub StopViewing
    If modeActif <> "watching" Then Exit Sub
    AppendInfo "Arret du visionnage via VLC..."
'	SendRC "stop"
    CloseVLC
    modeActif = ""
    UpdateButtons
    AppendInfo "Visionnage arrete."
End Sub

Sub TimerTick
    Dim elapsed, remaining
    If recording And Not IsVLCRunning() Then
        AppendInfo "VLC ferme ? arret."
        StopRecording
        Exit Sub
    End If

    elapsed = DateDiff("s", startDate, Now)
    remaining = durationSeconds - elapsed
    If remaining < 0 Then remaining = 0
    document.getElementById("bigTimer").innerText = FormatSeconds(remaining)

    If elapsed >= durationSeconds Then
        StopRecording
        AppendInfo "Duree atteinte."
    End If
	
	document.getElementById("elapsedTimer").innerText = FormatSeconds(elapsed)
	
End Sub

Sub ResetTimer
    document.getElementById("elapsedTimer").innerText = "00:00:00"
    document.getElementById("bigTimer").innerText = "--:--:--"
    document.getElementById("info").innerText = ""
End Sub

Function FormatSeconds(totalSeconds)
    Dim h, m, s
    h = totalSeconds \ 3600
    m = (totalSeconds Mod 3600) \ 60
    s = totalSeconds Mod 60
    FormatSeconds = Right("0"&h,2) & ":" & Right("0"&m,2) & ":" & Right("0"&s,2)
End Function

Sub ToggleSchedule
    Dim t
    If scheduleEnabled Then
        scheduleEnabled = False
        If scheduleTimerId <> "" Then
            window.clearInterval scheduleTimerId
            scheduleTimerId = ""
        End If
        document.getElementById("scheduleBtn").innerText = "OFF"
		
		document.getElementById("scheduleBtn").style.backgroundColor = "#DDDDDD"
		document.getElementById("scheduleBtn").style.color = "#989898"
		
        AppendInfo "Programmation désactivée"
    Else
        t = Trim(document.getElementById("scheduleTime").value)
        If t = "" Or InStr(t, ":") = 0 Then
            MsgBox "Indiquez une heure au format HH:MM", 48, "Erreur"
            Exit Sub
        End If
        scheduleTime = t
        scheduleEnabled = True
        document.getElementById("scheduleBtn").innerText = "ON"

		document.getElementById("scheduleBtn").style.backgroundColor = "#000000"
		document.getElementById("scheduleBtn").style.color = "#FFF"

        AppendInfo "Programmation activee pour " & scheduleTime
        scheduleTimerId = window.setInterval("CheckSchedule", 10000)
    End If
	SaveConfig
End Sub

Sub ModifierHeure
    document.getElementById("heureAffiche").innerHTML = _
        "<input type='text' class='saisie' style='background: #FFFFD9; width: 65px;' id='saisieHeure' onkeydown='ValiderEntreeHeure'>" & _
        "<button class='button' style='width: 65px;' onclick='ValiderHeure'>OK</button>"
    document.getElementById("saisieHeure").focus
End Sub

Sub ModifierMinute
    document.getElementById("minuteAffiche").innerHTML = _
        "<input type='text' class='saisie' style='background: #FFFFD9; width: 65px;' id='saisieMinute' onkeydown='ValiderEntreeMinute'>" & _
        "<button class='button' style='width: 65px;' onclick='ValiderMinute'>OK</button>"
    document.getElementById("saisieMinute").focus
End Sub

Sub ValiderEntreeHeure
    If window.event.keyCode = 13 Then ValiderHeure
End Sub

Sub ValiderEntreeMinute
    If window.event.keyCode = 13 Then ValiderMinute
End Sub

Sub AnnulerHeure
	If document.getElementById("heureAffiche").contains(document.activeElement) Then Exit Sub
	
    Dim h
    h = Left(document.getElementById("scheduleTime").value, 2)

    document.getElementById("heureAffiche").innerHTML = _
        "<button class='button' style='width: 138px;' onclick='ModifierHeure'>" & h & "</button>"
End Sub

Sub AnnulerMinute
	If document.getElementById("minuteAffiche").contains(document.activeElement) Then Exit Sub
	
    Dim m
    m = Right(document.getElementById("scheduleTime").value, 2)

    document.getElementById("minuteAffiche").innerHTML = _
        "<button class='button' style='width: 138px;' onclick='ModifierMinute'>" & m & "</button>"
End Sub

Sub ValiderHeure
    Dim h
    h = Trim(document.getElementById("saisieHeure").value)

    If Not IsNumeric(h) Then Exit Sub
    If CInt(h) < 0 Or CInt(h) > 23 Then Exit Sub

    document.getElementById("scheduleTime").value = _
        Right("0" & CInt(h), 2) & ":" & _
        Right(document.getElementById("scheduleTime").value, 2)

    document.getElementById("heureAffiche").innerHTML = _
        "<button class='button' style='width: 138px;' onclick='ModifierHeure'>" & _
        Right("0" & CInt(h), 2) & "</button>"
	SaveConfig
End Sub

Sub ValiderMinute
    Dim m
    m = Trim(document.getElementById("saisieMinute").value)

    If Not IsNumeric(m) Then Exit Sub
    If CInt(m) < 0 Or CInt(m) > 59 Then Exit Sub

    document.getElementById("scheduleTime").value = _
        Left(document.getElementById("scheduleTime").value, 2) & ":" & _
        Right("0" & CInt(m), 2)

    document.getElementById("minuteAffiche").innerHTML = _
        "<button class='button' style='width: 138px;' onclick='ModifierMinute'>" & _
        Right("0" & CInt(m), 2) & "</button>"
	SaveConfig
End Sub




Sub CheckSchedule

    Dim targetH, targetM, parts, targetDateTime

    If Not scheduleEnabled Or recording Then Exit Sub

    parts = Split(scheduleTime, ":")

    If UBound(parts) < 1 Then Exit Sub

    targetH = CInt(parts(0))
    targetM = CInt(parts(1))

    targetDateTime = DateSerial( _
        Year(scheduleDate), _
        Month(scheduleDate), _
        Day(scheduleDate)) + TimeSerial(targetH, targetM, 0)

    If Now >= targetDateTime Then

        ' Desactiver la programmation
        scheduleEnabled = False

        If scheduleTimerId <> "" Then
            window.clearInterval scheduleTimerId
            scheduleTimerId = ""
        End If

        document.getElementById("scheduleBtn").innerText = "Inactif"
        document.getElementById("scheduleBtn").style.backgroundColor = "#DDDDDD"
        document.getElementById("scheduleBtn").style.color = "#989898"

        document.getElementById("duration").value = _
            document.getElementById("duration_prog").value

        AppendInfo "Date et heure programmees atteintes : demarrage."

        StartRecording

    End If

End Sub



Sub ModifierDureeEnreg

    document.getElementById("dureeEnregAffiche").innerHTML = _
        "<input type='text' class='saisie' style='width:90px; background:#FFFFD9; text-align:center;' id='saisieDureeEnreg' onkeydown='ValiderEntreeDureeEnreg'>" & _
        "<button class='button' style='width:65px;' onclick='ValiderDureeEnreg'>OK</button>"

    document.getElementById("saisieDureeEnreg").focus

End Sub


Sub ValiderEntreeDureeEnreg

    If window.event.keyCode = 13 Then ValiderDureeEnreg

End Sub


Sub ValiderDureeEnreg

    Dim d

    d = Trim(document.getElementById("saisieDureeEnreg").value)

    If Not IsNumeric(d) Then Exit Sub
    If CDbl(d) <= 0 Then Exit Sub

    document.getElementById("duration").value = d

    document.getElementById("dureeEnregAffiche").innerHTML = _
        "<button class='button' style='width:160px;' onclick='ModifierDureeEnreg'>" & d & "</button>"

End Sub


Sub AnnulerDureeEnreg

    If document.getElementById("dureeEnregAffiche").contains(document.activeElement) Then Exit Sub

    Dim d

    d = document.getElementById("duration").value

    document.getElementById("dureeEnregAffiche").innerHTML = _
        "<button class='button' style='width:160px;' onclick='ModifierDureeEnreg'>" & d & "</button>"

End Sub



Sub ModifierDuree
    document.getElementById("dureeAffiche").innerHTML = _
        "<input type='text' class='saisie' style='width:90px; background:#FFFFD9; text-align:center;' id='saisieDuree' onkeydown='ValiderEntreeDuree'>" & _
        "<button class='button' style='width:65px;' onclick='ValiderDuree'>OK</button>"
    document.getElementById("saisieDuree").focus
End Sub


Sub ValiderEntreeDuree
    If window.event.keyCode = 13 Then ValiderDuree
End Sub

Sub ValiderDuree
    Dim d
    d = Trim(document.getElementById("saisieDuree").value)
    If Not IsNumeric(d) Then Exit Sub
    If CDbl(d) <= 0 Then Exit Sub
    document.getElementById("duration_prog").value = d
    document.getElementById("dureeAffiche").innerHTML = _
        "<button class='button' style='width:160px;' onclick='ModifierDuree'>" & d & "</button>"
	SaveConfig
End Sub

Sub AnnulerDuree
    If document.getElementById("dureeAffiche").contains(document.activeElement) Then Exit Sub
    Dim d
    d = document.getElementById("duration_prog").value
    document.getElementById("dureeAffiche").innerHTML = _
        "<button class='button' style='width:160px;' onclick='ModifierDuree'>" & d & "</button>"
End Sub


Sub ModifierIdent

    document.getElementById("identAffiche").innerHTML = _
        "<input type='text' id='saisieIdent' class='saisie' style='width:160px; background:#FFFFC0;'>" & _
        "<button class='button' style='width:65px;' onclick='ValiderIdent'>OK</button>"

    document.getElementById("saisieIdent").value = document.getElementById("identifier").value
    document.getElementById("saisieIdent").focus
End Sub

Sub ValiderIdent
    Dim id
    id = Trim(document.getElementById("saisieIdent").value)
    If id = "" Then Exit Sub
    document.getElementById("identifier").value = id
    SaveConfig
    document.getElementById("identAffiche").innerHTML = _
        "<button class='button' style='width:160px;' onclick='ModifierIdent'>ID utilisateur</button>"
End Sub

Sub AnnulerIdent
    If document.getElementById("identAffiche").contains(document.activeElement) Then Exit Sub
    document.getElementById("identAffiche").innerHTML = _
        "<button class='button' style='width:160px;' onclick='ModifierIdent'>ID utilisateur</button>"
End Sub

Sub OuvrirDossier
    Dim shell, fso
    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FolderExists(RECORD_DIR) Then
        MsgBox "Dossier introuvable : " & RECORD_DIR, 48, "Erreur"
        Exit Sub
    End If

    Set shell = CreateObject("WScript.Shell")
    shell.Run "explorer.exe """ & RECORD_DIR & """", 1, False

End Sub


Sub AfficherCalendrier

    calendarMonth = Month(scheduleDate)
    calendarYear = Year(scheduleDate)

    DessinerCalendrier

    document.getElementById("calendrier").style.display = "block"

End Sub


Sub DessinerCalendrier

    Dim html, firstDay, daysInMonth, d
    Dim i, iso, mois

    mois = Array("Janvier", "Fevrier", "Mars", "Avril", _
                 "Mai", "Juin", "Juillet", "Aout", _
                 "Septembre", "Octobre", "Novembre", "Decembre")

    firstDay = Weekday(DateSerial(calendarYear, calendarMonth, 1), vbMonday)
    daysInMonth = Day(DateSerial(calendarYear, calendarMonth + 1, 0))

    html = "<table width='100%' cellpadding='3' cellspacing='1'>"

    html = html & "<tr>"
    html = html & "<td><button onclick='MoisPrecedent'>&lt;</button></td>"
    html = html & "<td colspan='5' align='center'><b>" & _
           mois(calendarMonth - 1) & " " & calendarYear & "</b></td>"
    html = html & "<td><button onclick='MoisSuivant'>&gt;</button></td>"
    html = html & "</tr>"

    html = html & "<tr align='center'>"
    html = html & "<td>L</td><td>M</td><td>M</td>"
    html = html & "<td>J</td><td>V</td><td>S</td><td>D</td>"
    html = html & "</tr><tr>"

    For i = 1 To firstDay - 1
        html = html & "<td></td>"
    Next

    For d = 1 To daysInMonth

        iso = calendarYear & "-" & _
              Right("0" & calendarMonth, 2) & "-" & _
              Right("0" & d, 2)

        html = html & "<td align='center'>"
        html = html & "<button style='width:29px;height:29px;padding:0;' " & _
               "onclick=""ChoisirDate '" & iso & "'"">" & d & "</button>"
        html = html & "</td>"

        If (firstDay - 1 + d) Mod 7 = 0 Then
            html = html & "</tr><tr>"
        End If

    Next

    html = html & "</tr></table>"

    document.getElementById("calendrier").innerHTML = html

End Sub


Sub MoisPrecedent

    calendarMonth = calendarMonth - 1

    If calendarMonth < 1 Then
        calendarMonth = 12
        calendarYear = calendarYear - 1
    End If

    DessinerCalendrier

End Sub


Sub MoisSuivant

    calendarMonth = calendarMonth + 1

    If calendarMonth > 12 Then
        calendarMonth = 1
        calendarYear = calendarYear + 1
    End If

    DessinerCalendrier

End Sub

Sub DateToday
    scheduleDate = Date
    ActualiserDate
    SaveConfig
End Sub

Sub ChoisirDate(iso)
    scheduleDate = DateSerial( _
        CInt(Left(iso, 4)), _
        CInt(Mid(iso, 6, 2)), _
        CInt(Right(iso, 2)))

    ActualiserDate
	SaveConfig

    document.getElementById("calendrier").style.display = "none"
End Sub


Sub ActualiserDate
    document.getElementById("dateBtn").innerText = _
        Right("0" & Day(scheduleDate), 2) & "/" & _
        Right("0" & Month(scheduleDate), 2) & "/" & _
        Year(scheduleDate)

End Sub

</script>
</head>
<body>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 30px;">
    <tr>
        <td width="50%">
            <div id="elapsedTimer">00:00:00</div>
        </td>
        <td width="50%">
            <div id="bigTimer">--:--:--</div>
        </td>
    </tr>
</table>


    <div class="marge_txt">
        <select id="channelList"  class="saisie"></select> 
		<span class="texte_lib"> chaine TV </span>
    </div>	
    <div class="marge_txt">

<span id="dureeEnregAffiche" style="vertical-align: middle;"
      onfocusout="AnnulerDureeEnreg">
    <button class="button" style="width:160px;" onclick="ModifierDureeEnreg">60</button>
</span>
<input type="hidden" id="duration" value="60">	
		<span class="texte_lib"><b>Min &nbsp;</b></span>
		<span class="texte_lib"> (Cliquer pour modifier la durée)</span>
    </div>
    <div class="buttons">
		<button id="watchBtn" class="button" onclick="StartViewing">VOIR</button>
		<button id="startBtn" class="button" onclick="StartRecording">ENREG</button>
		<button id="stopBtn" class="button inactif" onclick="StopAction">STOP</button>
		<button id="razBtn" class="button" onclick="ResetTimer">RAZ</button>
    </div>


<fieldset>
    <legend>PROG</legend> 
<table width="100%" cellpadding="5" cellspacing="0" border="6" bordercolor="#CCCCCC" style="border-collapse: collapse">
    <tr>
		<td width="270px">
			<div style="white-space:nowrap;">
				<button class="button" style="width:160px;"
						id="dateBtn" onclick="AfficherCalendrier">
					11/11/2026
				</button>
				&nbsp; &nbsp;	
				<button class="button" style="width:110px;"
						onclick="DateToday">ce jour</button>
			</div>
		
			<div id="calendrier"
				style="display:none; position:absolute; z-index:1000;
					background:white; border:1px solid #777;
					padding:8px; width:245px;">
			</div>
		</td>		
        <td width="110px">
            <label>Durée</label>
        </td>
        <td>
            &nbsp;
        </td>
    </tr>
    <tr>
        <td>
			<span id="heureAffiche" onfocusout="AnnulerHeure" style="vertical-align: middle;">
				<button class="button" style="width: 138px;" onclick="ModifierHeure">12</button>
			</span>
			<span class="texte_lib"><b>H</b></span>
			<span id="minuteAffiche" style="vertical-align: middle;" onfocusout="AnnulerMinute">
				<button class="button" style="width: 138px;" onclick="ModifierMinute">00</button>
			</span>
			<input type="hidden" id="scheduleTime" value="12:00">
        </td>
        <td>
<span id="dureeAffiche" style="vertical-align: middle;" onfocusout="AnnulerDuree">
    <button class="button" style="width:160px;" onclick="ModifierDuree">90</button>
</span>
<span class="texte_lib"><b>&nbsp;Min</b></span>
			<input type="hidden" id="duration_prog" value="90">
        </td>
        <td>
            <button id="scheduleBtn" class="button" style="width:70px;" onclick="ToggleSchedule" 
				style="backgroundColor:#DDDDDD; color:#989898" >OFF</button>
			
        </td>
    </tr>
</table>
</fieldset>

<div class="marge_txt">

	<button id="mp4Btn" class="button"
        style="background:#555555;color:white;"
        onclick="OuvrirDossier">Fichiers</button>

    <span id="identAffiche" style="vertical-align:middle;" onfocusout="AnnulerIdent">
        <button class="button" style="width:160px;" onclick="ModifierIdent">
            ID utilisateur
        </button>
    </span>
    <input type="hidden" id="identifier">	
	
</div>

<fieldset>
    <div id="info"></div>
</fieldset>
</body>
</html>
